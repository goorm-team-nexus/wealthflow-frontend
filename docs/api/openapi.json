          },
          "executedAt": {
            "format": "date-time",
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "ticker": {
            "type": "string"
          },
          "totalAmount": {
            "type": "number"
          },
          "tradeType": {
            "enum": [
