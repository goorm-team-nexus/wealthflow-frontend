    "/api/v1/market/stocks/{ticker}": {
      "get": {
        "description": "티커 심볼로 실시간 주식 시세를 조회합니다.",
        "operationId": "getStockPrice",
        "parameters": [
          {
            "description": "주식 티커 심볼",
            "example": "AAPL",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseStockPriceResponse"
