        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "UserSignUpRequest": {
        "properties": {
          "email": {
            "example": "user@example.com",
            "format": "email",
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "example": "투자왕김철수",
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "example": "Password123!",
            "minLength": 1,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d)(?=.*[^A-Za-z0-9]).{9,}$",
            "type": "string"
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "Bearer Authentication": {
        "bearerFormat": "JWT",
        "name": "Bearer Authentication",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "WealthFlow 투자 플랫폼 API",
    "title": "WealthFlow API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/kakao": {
      "post": {
        "description": "카카오 OAuth 인증 코드로 로그인합니다.",
        "operationId": "kakaoLogin",
        "parameters": [
          {
            "description": "카카오 인증 코드",
            "example": "def1234567890abcde",
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTokenResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "카카오 로그인",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTokenResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "로그인",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "현재 기기의 refresh token family를 폐기합니다.",
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLogoutResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "로그아웃",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "RTR 방식으로 refresh token을 회전하고 새 token pair를 발급합니다.",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTokenResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "리프레시 토큰 재발급",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "operationId": "signUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserSignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "회원가입",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/favorites": {
      "get": {
        "description": "로그인한 사용자의 관심 종목 목록과 상승/하락 개수를 조회합니다.",
        "operationId": "getFavorites",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseFavoriteStockListResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ],
        "summary": "관심 종목 목록 조회",
        "tags": [
          "Favorite"
        ]
      },
      "post": {
        "description": "등록된 종목을 관심 종목에 추가합니다.",
        "operationId": "addFavorite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FavoriteStockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseFavoriteStockResultResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ],
        "summary": "관심 종목 추가",
        "tags": [
          "Favorite"
        ]
      }
    },
    "/api/v1/favorites/{ticker}": {
      "delete": {
        "description": "관심 종목에서 지정한 티커를 제거합니다.",
        "operationId": "removeFavorite",
        "parameters": [
          {
            "description": "주식 티커 심볼",
            "example": "005930",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseFavoriteStockResultResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ],
        "summary": "관심 종목 삭제",
        "tags": [
          "Favorite"
        ]
      }
    },
    "/api/v1/investments/order": {
      "post": {
        "description": "BUY/SELL 주문을 실행합니다.",
        "operationId": "placeOrder",
