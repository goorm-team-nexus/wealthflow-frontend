    "/api/v1/market/exchange/{currency}": {
      "get": {
        "description": "특정 통화의 원화 환율을 조회합니다.",
        "operationId": "getExchange",
        "parameters": [
          {
            "description": "통화 코드 (KRW, USD)",
            "example": "USD",
            "in": "path",
            "name": "currency",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseExchangeRateResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "환율 조회",
        "tags": [
          "Market"
        ]
      }
