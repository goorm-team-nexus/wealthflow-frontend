        "type": "object"
      },
      "UpdateUserProfileRequest": {
        "properties": {
          "avatarPresetId": {
            "example": 2,
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "currentPassword": {
            "example": "OldPassword1!",
            "type": "string"
          },
          "name": {
            "example": "홍길동",
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "newPassword": {
            "example": "NewPassword1!",
            "type": "string"
          },
          "newPasswordConfirm": {
            "example": "NewPassword1!",
            "type": "string"
          }
        },
        "required": [
          "avatarPresetId",
          "name"
        ],
        "type": "object"
      },
      "UserProfileResponse": {
        "properties": {
          "avatarPresetId": {
            "format": "int32",
            "type": "integer"
          },
          "email": {
            "type": "string"
          },
          "joinedAt": {
            "format": "date",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
