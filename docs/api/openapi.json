        "type": "object"
      },
      "ApiResponseMyPageResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MyPageResponse"
          },
          "success": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ApiResponseOrderResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/OrderResponse"
          },
          "success": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ApiResponsePortfolioResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PortfolioResponse"
          },
          "success": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ApiResponseStockPriceResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/StockPriceResponse"
          },
          "success": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ApiResponseTokenResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TokenResponse"
          },
          "success": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ApiResponseUserResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "success": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ExchangeRateResponse": {
        "properties": {
          "currency": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "rateDate": {
            "format": "date",
            "type": "string"
          }
        },
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "example": "user@example.com",
            "format": "email",
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "example": "Password123!",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "type": "object"
      },
      "LogoutResponse": {
        "properties": {
          "loggedOut": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "MyPageResponse": {
        "properties": {
          "cashBalance": {
            "type": "number"
          },
          "currencyCode": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "profitRate": {
            "format": "double",
            "type": "number"
          },
          "totalAsset": {
            "type": "number"
          },
          "totalProfit": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "OrderRequest": {
        "properties": {
          "quantity": {
            "example": 10,
            "type": "number"
          },
          "ticker": {
            "example": "AAPL",
            "minLength": 1,
            "type": "string"
          },
          "tradeType": {
            "enum": ["BUY", "SELL"],
            "example": "BUY",
            "type": "string"
          }
        },
        "required": ["quantity", "ticker", "tradeType"],
        "type": "object"
      },
      "OrderResponse": {
        "properties": {
          "currency": {
            "enum": ["KRW", "USD"],
            "type": "string"
          },
          "executedAt": {
            "format": "date-time",
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "ticker": {
            "type": "string"
          },
          "totalAmount": {
            "type": "number"
          },
          "tradeType": {
            "enum": ["BUY", "SELL"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "PortfolioItemResponse": {
        "properties": {
          "averagePrice": {
            "type": "number"
          },
          "currentPrice": {
            "type": "number"
          },
          "evaluationAmount": {
            "type": "number"
          },
          "priceUpdatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "profitLoss": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "ticker": {
            "type": "string"
          },
          "yieldRate": {
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "PortfolioResponse": {
        "properties": {
          "evaluatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PortfolioItemResponse"
            },
            "type": "array"
          },
          "totalEvaluation": {
            "type": "number"
          },
          "totalInvestment": {
            "type": "number"
          },
          "totalProfitLoss": {
            "type": "number"
          },
          "totalYieldRate": {
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refreshToken": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["refreshToken"],
        "type": "object"
      },
      "StockPriceResponse": {
        "properties": {
          "changePrice": {
            "type": "number"
          },
          "changeRate": {
            "format": "double",
            "type": "number"
          },
          "currentPrice": {
            "type": "number"
          },
          "marketCap": {
            "format": "int64",
            "type": "integer"
          },
          "per": {
            "format": "double",
            "type": "number"
          },
          "priceUpdatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "range52w": {
            "type": "string"
          },
          "ticker": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "UserSignUpRequest": {
        "properties": {
          "email": {
            "example": "user@example.com",
            "format": "email",
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "example": "투자왕김철수",
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "example": "Password123!",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["email", "name", "password"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "Bearer Authentication": {
        "bearerFormat": "JWT",
        "name": "Bearer Authentication",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "WealthFlow 투자 플랫폼 API",
    "title": "WealthFlow API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/kakao": {
      "post": {
        "description": "카카오 OAuth 인증 코드로 로그인합니다.",
        "operationId": "kakaoLogin",
        "parameters": [
          {
            "description": "카카오 인증 코드",
            "example": "def1234567890abcde",
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTokenResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "카카오 로그인",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTokenResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "로그인",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "현재 기기의 refresh token family를 폐기합니다.",
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLogoutResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "로그아웃",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "RTR 방식으로 refresh token을 회전하고 새 token pair를 발급합니다.",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTokenResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "리프레시 토큰 재발급",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "operationId": "signUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserSignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "회원가입",
        "tags": ["Auth"]
      }
    },
    "/api/v1/investments/order": {
      "post": {
        "description": "BUY/SELL 주문을 실행합니다.",
        "operationId": "placeOrder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ],
        "summary": "주식 주문",
        "tags": ["Investment"]
      }
    },
    "/api/v1/investments/portfolio": {
      "get": {
        "operationId": "getPortfolio",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePortfolioResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ],
        "summary": "포트폴리오 조회",
        "tags": ["Investment"]
      }
    },
    "/api/v1/market/exchange/{currency}": {
      "get": {
        "description": "특정 통화의 원화 환율을 조회합니다.",
        "operationId": "getExchange",
        "parameters": [
          {
            "description": "통화 코드 (KRW, USD)",
            "example": "USD",
            "in": "path",
            "name": "currency",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseExchangeRateResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "환율 조회",
        "tags": ["Market"]
      }
    },
    "/api/v1/market/stocks/{ticker}": {
      "get": {
        "description": "티커 심볼로 실시간 주식 시세를 조회합니다.",
        "operationId": "getStockPrice",
        "parameters": [
          {
            "description": "주식 티커 심볼",
            "example": "AAPL",
            "in": "path",
            "name": "ticker",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseStockPriceResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "주식 시세 조회",
        "tags": ["Market"]
      }
    },
    "/api/v1/user/me": {
      "get": {
        "operationId": "getMyPage",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMyPageResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ],
        "summary": "마이페이지 조회",
        "tags": ["User"]
      }
    }
  },
